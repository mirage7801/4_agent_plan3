    "max_model_calls": 7,
    "require_evidence_manifest": true
  },
  "eda": {
    "adapter": "cli",
    "validator_root": "../eda/rtl-agent",
    "validator_entry": "tools/validate_rtl.py",
    "python_executable": null,
    "target_part": "xczu3eg-sbva484-1-e",
    "clock_period_ns": 5.0,
    "timeouts": {
      "compile_seconds": 60,
      "elaborate_seconds": 60,
      "simulation_seconds": 120,
